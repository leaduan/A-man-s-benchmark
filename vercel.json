{
  "version": 2,
  "regions": ["sin1"],
  "builds": [
    {
      "src": "backend/benchmark_project/wsgi.py",
      "use": "@vercel/python",
      "config": { "maxLambdaSize": "15mb", "runtime": "python3.11" }
    },
    {
      "src": "build_files.sh",
      "use": "@vercel/static-build",
      "config": { "distDir": "staticfiles" }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "backend/benchmark_project/wsgi.py"
    },
    {
      "src": "/admin/(.*)",
      "dest": "backend/benchmark_project/wsgi.py"
    },
    {
      "src": "/static/(.*)",
      "dest": "/$1"
    },
    {
      "src": "/css/(.*)",
      "dest": "/css/$1"
    },
    {
      "src": "/js/(.*)",
      "dest": "/js/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "env": {
    "DJANGO_SETTINGS_MODULE": "benchmark_project.settings"
  }
}
